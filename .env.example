# Sage X3 (source system)
SAGE_BASE_URL=https://erp.peenergy.net
SAGE_USERNAME=API
SAGE_PASSWORD=change-me
# Full path (relative to SAGE_BASE_URL) of the endpoint that lists sales invoices / credit notes.
# See README.md "Sage X3 integration" section - this must be confirmed against the real API.
SAGE_INVOICE_ENDPOINT=
SAGE_CREDIT_NOTE_ENDPOINT=

# Cryptware NRS / FIRS e-invoicing API
NRS_BASE_URL=https://preprod-api.cryptwaresystemsltd.com
NRS_API_KEY=change-me
NRS_ENTITY_NAME=PE ENERGY LTD

# Sync behaviour
POLL_INTERVAL_MINUTES=5
MAX_SUBMIT_ATTEMPTS=5
DEFAULT_TRANSACTION_CATEGORY=B2B

# Where sync state (what's been submitted, IRNs, statuses) is persisted
STATE_FILE=./data/sync-state.json

# Local invoice viewer
VIEWER_PORT=4000
