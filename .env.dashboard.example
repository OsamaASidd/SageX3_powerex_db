# Dashboard-only settings (read after .env). Kept separate because .env is read-only for this account.

# Sage X3 SQL Server (direct read access)
SQL_SERVER=EC2AMAZ-U81DLVN\SAGEX3SQLSERVER
SQL_DATABASE=x3data
SQL_SCHEMA=PENERGY
SQL_USER=sagex3
SQL_PASSWORD=change-me

# Invoice dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=4100
DASHBOARD_PUBLIC_URL=http://34.249.148.146:4100
DASHBOARD_USER=pe-energy
DASHBOARD_PASSWORD=change-me

# NRS / FIRS e-invoicing via Cryptware. NRS_ENV picks which key and URL the Post button uses.
NRS_ENV=preprod
NRS_ENTITY_NAME=PE ENERGY LTD
NRS_PREPROD_BASE_URL=https://preprod-api.cryptwaresystemsltd.com
NRS_PREPROD_API_KEY=change-me
# Production base URL still to be confirmed with Cryptware; posting to prod is refused while it is empty.
NRS_PROD_BASE_URL=
NRS_PROD_API_KEY=change-me
# HS code sent for lines whose item has no ZHSN value (format 0000.00). Leave empty to block such posts.
NRS_DEFAULT_HSN_CODE=

# Customer fields the NRS API requires. Used only when X3 has no value for the customer.
NRS_DEFAULT_BUSINESS_DESCRIPTION=Customer
# City when the invoice address has none and none can be read from the street line.
NRS_DEFAULT_CITY=Lagos
NRS_DEFAULT_POSTAL_ZONE=100001
# PRE-PROD TESTING ONLY: stand-ins for a missing customer email / phone / TIN.
# Ignored when NRS_ENV=prod (real data must come from X3 there).
NRS_PREPROD_PLACEHOLDER_EMAIL=customer@example.com
NRS_PREPROD_PLACEHOLDER_PHONE=+2348000000000
NRS_PREPROD_PLACEHOLDER_TIN=00000000-0001

# Logs: daily app-*.log and nrs-*.log files. Defaults: dashboard\logs, kept 90 days.
LOG_DIR=
LOG_RETENTION_DAYS=90